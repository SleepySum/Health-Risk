# HealthRisk AI / HealthRisk Lab — environment template
#
# Copy to .env and fill in real values. This file is intentionally empty of
# secrets and is tracked in Git; .env itself is ignored by Git.
#
# Every adapter that needs a secret will log a warning and fall back to
# deterministic mock data when the value is missing.

# openFDA / FAERS access (optional; raises rate limits)
OPENFDA_API_KEY=

# ClinicalTrials.gov courtesy identification
CLINICALTRIALS_EMAIL=research@example.com

# Local MIMIC-IV extract path or URI; used by the acquisition module.
# When unset, the pipeline generates synthetic but schema-valid mock data.
MIMIC_INGEST_PATH=

# Optional: path overrides that differ from configs/config.yaml defaults
DATA_ROOT=./data
MODELS_ROOT=./models
